# Variable NAMES only. Real values live in .env.local (gitignored) or platform env settings.
# See docs/DEVELOPMENT.md before pointing anything at a Convex deployment.
# .env.local = LOCAL Convex (default). .env.cloud.local = CLOUD dev deployment
# (explicit-target only). Never mix the two.

# --- Convex (written by `npx convex deployment select` / `npx convex dev`) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Runtime flags (non-secret) ---
# The worker runtime fails closed unless this is explicitly true.
LIVE_AI_ENABLED=false
# When true, Stage-3 option selection among already-eligible options uses Jev
# (typesafe-ai/jev via AI Gateway). Missing/invalid gateway responses fail closed
# — there is no silent fallback to unconstrained model selection while enabled.
# Requires AI_GATEWAY_API_KEY on the Convex deployment (never commit the key).
JEV_OPTION_SELECTION_ENABLED=false
AI_PROVIDER=openrouter
# Deliberate model selection: set to a tool-capable model. The objective
# runtime refuses to start a worker run without it and records the choice on
# every run.
AI_MODEL=
# Set on the Convex deployment (dashboard: Settings → Environment Variables)
# so scheduled worker runs can reach the model provider.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Required only when JEV_OPTION_SELECTION_ENABLED=true (Vercel AI Gateway for
# typesafe-ai/jev). Never commit real values; never log this key.
AI_GATEWAY_API_KEY=

# --- Model providers (local scripts only) ---
EXA_API_KEY=
