# Variable NAMES only. Real values live in .env.local (gitignored) or platform env settings.
# See docs/ENVIRONMENTS.md before pointing anything at a Convex deployment.

# --- Convex (written by `npx convex deployment select` / `npx convex dev`) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Runtime flags (non-secret) ---
LIVE_AI_ENABLED=false
AI_PROVIDER=openrouter
# Select a tool-capable model explicitly; use a :free OpenRouter model first.
AI_MODEL=openrouter/free
# Local server and Convex Development must share a random token (at least 32 characters).
DEVELOPMENT_ACCESS_TOKEN=
# IANA timezone for supplier weekday/time phrasing (default Asia/Singapore).
SOMEBODY_TIME_ZONE=Asia/Singapore

# --- Model providers (server only; set on Convex Development for scheduled agent runs) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
EXA_API_KEY=

# --- Google Workspace ---
# Set GOOGLE_WORKSPACE_LIVE=true only when deliberately using real Google APIs.
GOOGLE_WORKSPACE_LIVE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_EVENT_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Comparison
# Controlled Vendor B mailbox. Prefer opaque endpointRef map; single-studio helper allowed.
GMAIL_VENDOR_STUDIO_TO=
# JSON object: { "dev.gmail.paper-pine": "vendor@controlled.example" }
GMAIL_RECIPIENTS_JSON=
GMAIL_FROM=

# --- Unipile: WhatsApp + Instagram ---
UNIPILE_API_KEY=
UNIPILE_DSN=
# Shared secret for POST /webhooks/unipile?token=... (min 16 chars). Set on Convex Development too.
UNIPILE_WEBHOOK_SECRET=
# JSON array of vendor bindings. Model never sees these identities — only vendorId.
# [{"endpointRef":"dev.whatsapp.good-things","provider":"whatsapp","accountId":"...","chatId":"...","accountUserId":"..."},
#  {"endpointRef":"dev.instagram.little-objects","provider":"instagram","accountId":"...","chatId":"...","accountUserId":"..."}]
UNIPILE_BINDINGS_JSON=

# --- QuickBooks Online Sandbox (purchase-order adapter) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/callback
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
# Optional overrides when the Sandbox company already has stable refs:
# QBO_EXPENSE_ACCOUNT_ID=
# QBO_ITEM_ID=
# QBO_ENVIRONMENT must never be production for this lane.
